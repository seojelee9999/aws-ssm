# Metadata only. Supply actual values through TF_VAR_parameter_values.
parameter_prefix = "/myapp/dev"

parameters = {
  DB_HOST = {
    type          = "String"
    description   = "Application database host"
    value_version = 1
  }
  DB_PASSWORD = {
    type          = "SecureString"
    description   = "Application database password"
    value_version = 1
    # Optional customer-managed KMS key ARN. Omit to use the default SSM key.
    # key_id = "arn:aws:kms:ap-northeast-2:123456789012:key/your-key-id"
  }
}

tags = {
  Project     = "myapp"
  Environment = "dev"
}
